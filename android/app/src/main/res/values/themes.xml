<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only. The window is the ground colour from the first frame, so
         the app never flashes white while Compose starts. -->
    <style name="Theme.Pace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
